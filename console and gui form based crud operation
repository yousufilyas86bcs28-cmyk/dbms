    private void doInsert() {
        JTextField[] fields = {
            ins_ArticleNo, ins_SenderNo, ins_ReceiverNo, ins_OfficeCode,
            ins_UrgencyCode, ins_Weight, ins_ReceiptNo, ins_BookingOffice,
            ins_BookingEmp, ins_Charges
        };
        for (JTextField f : fields) {
            if (f.getText().trim().isEmpty()) {
                JOptionPane.showMessageDialog(this, "All * fields are required.");
                f.requestFocus();
                return;
            }
        }

        try {
            conn.setAutoCommit(false);

            String sql1 = "INSERT INTO article (article_no, sender_no, receiver_no, " +
                          "article_type, current_status, office_code, urgency_code, " +
                          "size_category, weight) VALUES (?,?,?,?,?,?,?,?,?)";
            PreparedStatement ps1 = conn.prepareStatement(sql1);
            ps1.setInt   (1, Integer.parseInt(ins_ArticleNo.getText().trim()));
            ps1.setInt   (2, Integer.parseInt(ins_SenderNo.getText().trim()));
            ps1.setInt   (3, Integer.parseInt(ins_ReceiverNo.getText().trim()));
            ps1.setString(4, (String) ins_ArticleType.getSelectedItem());
            ps1.setString(5, (String) ins_Status.getSelectedItem());
            ps1.setInt   (6, Integer.parseInt(ins_OfficeCode.getText().trim()));
            ps1.setInt   (7, Integer.parseInt(ins_UrgencyCode.getText().trim()));
            ps1.setString(8, (String) ins_SizeCategory.getSelectedItem());
            ps1.setInt   (9, Integer.parseInt(ins_Weight.getText().trim()));
            ps1.executeUpdate();

            String sql2 = "INSERT INTO booking_info (receipt_no, booking_officecode, " +
                          "booking_empno, article_no, charges) VALUES (?,?,?,?,?)";
            PreparedStatement ps2 = conn.prepareStatement(sql2);
            ps2.setInt  (1, Integer.parseInt(ins_ReceiptNo.getText().trim()));
            ps2.setInt  (2, Integer.parseInt(ins_BookingOffice.getText().trim()));
            ps2.setInt  (3, Integer.parseInt(ins_BookingEmp.getText().trim()));
            ps2.setInt  (4, Integer.parseInt(ins_ArticleNo.getText().trim()));
            ps2.setFloat(5, Float.parseFloat(ins_Charges.getText().trim()));
            ps2.executeUpdate();

            conn.commit();
            setStatus("Insert successful - Article #" + ins_ArticleNo.getText());
            JOptionPane.showMessageDialog(this, "Booking inserted successfully!");
            printArticleToConsole(Integer.parseInt(ins_ArticleNo.getText().trim()));
            clearInsertForm();

        } catch (SQLException e) {
            try { conn.rollback(); } catch (SQLException ex) {}
            JOptionPane.showMessageDialog(this, "Insert failed:\n" + e.getMessage(), "Error", JOptionPane.ERROR_MESSAGE);
        } catch (NumberFormatException e) {
            JOptionPane.showMessageDialog(this, "Please enter valid numbers in numeric fields.", "Error", JOptionPane.ERROR_MESSAGE);
        }
    }

    private void doUpdate() {
        if (upd_ArticleNo.getText().trim().isEmpty()) {
            JOptionPane.showMessageDialog(this, "Article No is required.");
            upd_ArticleNo.requestFocus();
            return;
        }

        try {
            conn.setAutoCommit(false);
            int articleNo = Integer.parseInt(upd_ArticleNo.getText().trim());

            String sql1Full = "UPDATE article SET current_status=?, size_category=?, urgency_code=?, weight=? WHERE article_no=?";
            PreparedStatement ps1 = conn.prepareStatement(sql1Full);
            ps1.setString(1, (String) upd_Status.getSelectedItem());
            ps1.setString(2, (String) upd_SizeCategory.getSelectedItem());
            ps1.setInt   (3, upd_UrgencyCode.getText().trim().isEmpty() ? 0 : Integer.parseInt(upd_UrgencyCode.getText().trim()));
            ps1.setInt   (4, upd_Weight.getText().trim().isEmpty() ? 0 : Integer.parseInt(upd_Weight.getText().trim()));
            ps1.setInt   (5, articleNo);

            int rows = ps1.executeUpdate();
            if (rows == 0) {
                conn.rollback();
                JOptionPane.showMessageDialog(this, "No article found with Article No: " + articleNo);
                return;
            }

            if (!upd_Charges.getText().trim().isEmpty()) {
                String sql2 = "UPDATE booking_info SET charges=? WHERE article_no=?";
                PreparedStatement ps2 = conn.prepareStatement(sql2);
                ps2.setFloat(1, Float.parseFloat(upd_Charges.getText().trim()));
                ps2.setInt  (2, articleNo);
                ps2.executeUpdate();
            }

            conn.commit();
            setStatus("Update successful - Article #" + articleNo);
            JOptionPane.showMessageDialog(this, "Booking updated successfully!");
            printArticleToConsole(articleNo);
            clearUpdateForm();

        } catch (SQLException e) {
            try { conn.rollback(); } catch (SQLException ex) {}
            JOptionPane.showMessageDialog(this, "Update failed:\n" + e.getMessage(), "Error", JOptionPane.ERROR_MESSAGE);
        } catch (NumberFormatException e) {
            JOptionPane.showMessageDialog(this, "Please enter valid numbers in numeric fields.", "Error", JOptionPane.ERROR_MESSAGE);
        }
    }

    private void doDelete() {
        if (del_ArticleNo.getText().trim().isEmpty()) {
            JOptionPane.showMessageDialog(this, "Article No is required.");
            del_ArticleNo.requestFocus();
            return;
        }

        int confirm = JOptionPane.showConfirmDialog(this,
            "Are you sure you want to delete Article #" + del_ArticleNo.getText() + "?",
            "Confirm Delete", JOptionPane.YES_NO_OPTION);
        if (confirm != JOptionPane.YES_OPTION) return;

        try {
            conn.setAutoCommit(false);
            int articleNo = Integer.parseInt(del_ArticleNo.getText().trim());

            PreparedStatement ps1 = conn.prepareStatement("DELETE FROM booking_info WHERE article_no=?");
            ps1.setInt(1, articleNo);
            ps1.executeUpdate();

            PreparedStatement ps2 = conn.prepareStatement("DELETE FROM article WHERE article_no=?");
            ps2.setInt(1, articleNo);
            int rows = ps2.executeUpdate();

            if (rows == 0) {
                conn.rollback();
                JOptionPane.showMessageDialog(this, "No article found with Article No: " + articleNo);
                return;
            }

            conn.commit();
            setStatus("Deleted Article #" + articleNo);
            System.out.println("[DELETE] Article #" + articleNo + " deleted from database.");
            JOptionPane.showMessageDialog(this, "Article deleted successfully!");
            del_ArticleNo.setText("");

        } catch (SQLException e) {
            try { conn.rollback(); } catch (SQLException ex) {}
            JOptionPane.showMessageDialog(this, "Delete failed:\n" + e.getMessage(), "Error", JOptionPane.ERROR_MESSAGE);
        } catch (NumberFormatException e) {
            JOptionPane.showMessageDialog(this, "Please enter a valid Article No.", "Error", JOptionPane.ERROR_MESSAGE);
        }
    }

    private void loadViewTable() {
        viewTableModel.setRowCount(0);
        if (conn == null) return;

        String sql = "SELECT * FROM (" +
                     "  SELECT b.receipt_no, a.article_no, a.sender_no, a.receiver_no, " +
                     "         a.article_type, a.current_status, a.office_code, " +
                     "         a.size_category, a.weight, b.charges " +
                     "  FROM article a " +
                     "  JOIN booking_info b ON a.article_no = b.article_no " +
                     "  ORDER BY b.receipt_no DESC" +
                     ") WHERE ROWNUM <= 10";

        try {
            Statement st = conn.createStatement();
            ResultSet rs = st.executeQuery(sql);

            while (rs.next()) {
                viewTableModel.addRow(new Object[]{
                    rs.getInt("receipt_no"),
                    rs.getInt("article_no"),
                    rs.getInt("sender_no"),
                    rs.getInt("receiver_no"),
                    rs.getString("article_type"),
                    rs.getString("current_status"),
                    rs.getInt("office_code"),
                    rs.getString("size_category"),
                    rs.getInt("weight"),
                    String.format("Rs %.2f", rs.getFloat("charges"))
                });
            }
            setStatus("Loaded " + viewTableModel.getRowCount() + " booking(s).");
        } catch (SQLException e) {
            setStatus("Could not load bookings: " + e.getMessage());
        }
    }

    private void printArticleToConsole(int articleNo) {
        String sql = "SELECT b.receipt_no, a.article_no, a.sender_no, a.receiver_no, " +
                     "       a.article_type, a.current_status, a.office_code, " +
                     "       a.urgency_code, a.size_category, a.weight, b.charges, " +
                     "       b.booking_officecode, b.booking_empno " +
                     "FROM article a " +
                     "JOIN booking_info b ON a.article_no = b.article_no " +
                     "WHERE a.article_no = ?";
        try {
            PreparedStatement ps = conn.prepareStatement(sql);
            ps.setInt(1, articleNo);
            ResultSet rs = ps.executeQuery();

            if (rs.next()) {
                String line = "=".repeat(55);
                System.out.println("\n" + line);
                System.out.println("    POST OFFICE - ARTICLE BOOKING DETAIL");
                System.out.println(line);
                System.out.printf("  %-22s : %d%n",    "Receipt No",       rs.getInt("receipt_no"));
                System.out.printf("  %-22s : %d%n",    "Article No",       rs.getInt("article_no"));
                System.out.printf("  %-22s : %d%n",    "Sender No",        rs.getInt("sender_no"));
                System.out.printf("  %-22s : %d%n",    "Receiver No",      rs.getInt("receiver_no"));
                System.out.printf("  %-22s : %s%n",    "Article Type",     rs.getString("article_type"));
                System.out.printf("  %-22s : %s%n",    "Status",           rs.getString("current_status"));
                System.out.printf("  %-22s : %d%n",    "Office Code",      rs.getInt("office_code"));
                System.out.printf("  %-22s : %d%n",    "Urgency Code",     rs.getInt("urgency_code"));
                System.out.printf("  %-22s : %s%n",    "Size Category",    rs.getString("size_category"));
                System.out.printf("  %-22s : %d kg%n", "Weight",           rs.getInt("weight"));
                System.out.printf("  %-22s : %d%n",    "Booking Office",   rs.getInt("booking_officecode"));
                System.out.printf("  %-22s : %d%n",    "Booking Employee", rs.getInt("booking_empno"));
                System.out.printf("  %-22s : Rs %.2f%n","Charges",         rs.getFloat("charges"));
                System.out.printf("  %-22s : %s%n",    "Printed At",
                    new SimpleDateFormat("dd-MM-yyyy HH:mm:ss").format(new Date()));
                System.out.println(line + "\n");
                setStatus("Detail for Article #" + articleNo + " printed to console.");
            } else {
                System.out.println("[PRINT] No record found for Article #" + articleNo);
            }
        } catch (SQLException e) {
            System.out.println("[PRINT] Error: " + e.getMessage());
        }
    }

