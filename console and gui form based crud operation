            System.out.print("Weight (kg)    : "); int weight     = sc.nextInt();
            System.out.print("Receipt No     : "); int receiptNo  = sc.nextInt();
            System.out.print("Booking Office : "); int bkOffice   = sc.nextInt();
            System.out.print("Booking Emp No : "); int bkEmp      = sc.nextInt();
            System.out.print("Charges (Rs)   : "); float charges  = sc.nextFloat();

            try {
                conn.setAutoCommit(false);

                PreparedStatement ps1 = conn.prepareStatement(
                    "INSERT INTO article (article_no, sender_no, receiver_no, article_type, " +
                    "current_status, office_code, urgency_code, size_category, weight) VALUES (?,?,?,?,?,?,?,?,?)");
                ps1.setInt(1, artNo); ps1.setInt(2, sndNo); ps1.setInt(3, rcvNo);
                ps1.setString(4, artType); ps1.setString(5, status);
                ps1.setInt(6, offCode); ps1.setInt(7, urgCode);
                ps1.setString(8, sizeCat); ps1.setInt(9, weight);
                ps1.executeUpdate();

                PreparedStatement ps2 = conn.prepareStatement(
                    "INSERT INTO booking_info (receipt_no, booking_officecode, booking_empno, article_no, charges) VALUES (?,?,?,?,?)");
                ps2.setInt(1, receiptNo); ps2.setInt(2, bkOffice);
                ps2.setInt(3, bkEmp); ps2.setInt(4, artNo); ps2.setFloat(5, charges);
                ps2.executeUpdate();

                conn.commit();
                System.out.println("[INSERT] Article #" + artNo + " inserted successfully.");
                printArticleToConsole(artNo);

                SwingUtilities.invokeLater(() -> setStatus("Console insert done - Article #" + artNo));
            } catch (SQLException e) {
                try { conn.rollback(); } catch (SQLException ex) {}
                System.out.println("[INSERT ERROR] " + e.getMessage());
            }
        }).start();
    }

    private void consoleUpdate() {
        new Thread(() -> {
            Scanner sc = new Scanner(System.in);
            System.out.println("\n--- CONSOLE UPDATE ---");
            System.out.print("Article No to update : "); int artNo = sc.nextInt();
            sc.nextLine();
            System.out.print("New Status           : "); String status  = sc.nextLine();
            System.out.print("New Size Category    : "); String sizeCat = sc.nextLine();
            System.out.print("New Urgency Code     : "); int urgCode    = sc.nextInt();
            System.out.print("New Weight (kg)      : "); int weight     = sc.nextInt();
            System.out.print("New Charges (Rs)     : "); float charges  = sc.nextFloat();

            try {
                conn.setAutoCommit(false);

                PreparedStatement ps1 = conn.prepareStatement(
                    "UPDATE article SET current_status=?, size_category=?, urgency_code=?, weight=? WHERE article_no=?");
                ps1.setString(1, status); ps1.setString(2, sizeCat);
                ps1.setInt(3, urgCode); ps1.setInt(4, weight); ps1.setInt(5, artNo);
                int rows = ps1.executeUpdate();

                if (rows == 0) {
                    conn.rollback();
                    System.out.println("[UPDATE] No article found with No: " + artNo);
                    return;
                }

                PreparedStatement ps2 = conn.prepareStatement(
                    "UPDATE booking_info SET charges=? WHERE article_no=?");
                ps2.setFloat(1, charges); ps2.setInt(2, artNo);
                ps2.executeUpdate();

                conn.commit();
                System.out.println("[UPDATE] Article #" + artNo + " updated successfully.");
                printArticleToConsole(artNo);

                SwingUtilities.invokeLater(() -> setStatus("Console update done - Article #" + artNo));
            } catch (SQLException e) {
                try { conn.rollback(); } catch (SQLException ex) {}
                System.out.println("[UPDATE ERROR] " + e.getMessage());
            }
        }).start();
    }

    private void consoleDelete() {
        new Thread(() -> {
            Scanner sc = new Scanner(System.in);
            System.out.println("\n--- CONSOLE DELETE ---");
            System.out.print("Article No to delete : "); int artNo = sc.nextInt();
            System.out.print("Confirm delete? (1=Yes / 0=No) : "); int confirm = sc.nextInt();

            if (confirm != 1) {
                System.out.println("[DELETE] Cancelled.");
                return;
            }

            try {
                conn.setAutoCommit(false);

                PreparedStatement ps1 = conn.prepareStatement("DELETE FROM booking_info WHERE article_no=?");
                ps1.setInt(1, artNo);
                ps1.executeUpdate();

                PreparedStatement ps2 = conn.prepareStatement("DELETE FROM article WHERE article_no=?");
                ps2.setInt(1, artNo);
                int rows = ps2.executeUpdate();

                if (rows == 0) {
                    conn.rollback();
                    System.out.println("[DELETE] No article found with No: " + artNo);
                    return;
                }

                conn.commit();
                System.out.println("[DELETE] Article #" + artNo + " deleted successfully.");
                SwingUtilities.invokeLater(() -> setStatus("Console delete done - Article #" + artNo));
            } catch (SQLException e) {
                try { conn.rollback(); } catch (SQLException ex) {}
                System.out.println("[DELETE ERROR] " + e.getMessage());
            }
        }).start();
    }

    private JTextField addRow(JPanel panel, GridBagConstraints gc, String label, int col, int row) {
        addLabel(panel, gc, label, col, row);
        JTextField field = new JTextField(10);
        gc.gridx = col + 1; gc.gridy = row; gc.gridwidth = 1;
        panel.add(field, gc);
        return field;
    }

    private void addLabel(JPanel panel, GridBagConstraints gc, String text, int col, int row) {
        JLabel label = new JLabel(text);
        label.setFont(new Font("Arial", Font.PLAIN, 12));
        gc.gridx = col; gc.gridy = row; gc.gridwidth = 1;
        panel.add(label, gc);
    }

